<view class="page wishes-page">
  <view class="page-header">
    <view class="header-row">
      <text class="brand-label">退路备忘录</text>
      <text class="count-badge">{{wishCountText}}</text>
    </view>
    <text class="header-copy">如果有一天离开这里，你最想先做什么？</text>
    <text class="cloud-status" wx:if="{{cloudSyncText}}">{{cloudSyncText}}</text>
  </view>

  <view class="hero-card section">
    <text class="hero-title">先记最想做的 3 件事</text>
    <text class="hero-copy">{{heroHint}}</text>
  </view>

  <view class="wish-list" wx:if="{{hasWishes}}">
    <view class="wish-card" wx:for="{{wishes}}" wx:key="id">
      <view class="wish-top">
        <view class="wish-tags">
          <text class="wish-tag">{{item.categoryLabel}}</text>
          <text class="wish-tag status-tag">{{item.statusLabel}}</text>
        </view>
        <view class="wish-actions">
          <text class="action-item pin-item {{item.pinned ? 'active' : ''}}" data-id="{{item.id}}" bindtap="togglePin">{{item.pinned ? '已重点' : '设为重点'}}</text>
          <text class="action-item" data-id="{{item.id}}" bindtap="convertToChecklist">转为清单</text>
          <text class="action-item" data-id="{{item.id}}" bindtap="shareWish">分享</text>
          <text class="action-item" data-id="{{item.id}}" bindtap="openEdit">编辑</text>
          <text class="action-item" data-id="{{item.id}}" bindtap="removeWish">删除</text>
        </view>
      </view>
      <text class="wish-title">{{item.pinned ? '重点 · ' : ''}}{{item.title}}</text>
      <text class="wish-meta">{{item.costText}}</text>
      <text class="wish-step">{{item.stepText}}</text>
    </view>
  </view>

  <view class="empty-card section" wx:else>
    <text class="empty-title">还没有愿望</text>
    <text class="empty-copy">可以先写“睡到自然醒一周”，也可以写“准备转行三个月”。</text>
  </view>

  <button class="primary-button add-button" bindtap="openCreate" disabled="{{limitReached}}">
    {{addButtonText}}
  </button>

  <view class="editor-mask" wx:if="{{showEditor}}" bindtap="closeEditor">
    <view class="editor-panel" catchtap="noop">
      <view class="editor-head">
        <view>
          <text class="editor-title">{{form.editorTitle}}</text>
          <text class="editor-copy">把想做的事先写下来，后面再慢慢补预算和第一步。</text>
        </view>
        <text class="close-text" bindtap="closeEditor">关闭</text>
      </view>

      <view class="field">
        <text class="label">标题</text>
        <input class="input" value="{{form.title}}" maxlength="24" placeholder="例如：去云南住一个月" bindinput="onTitleInput" />
      </view>

      <view class="field">
        <text class="label">分类</text>
        <picker value="{{form.categoryIndex}}" range="{{categoryLabels}}" bindchange="onCategoryChange">
          <view class="picker-shell">{{categoryLabels[form.categoryIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">当前状态</text>
        <picker value="{{form.statusIndex}}" range="{{statusLabels}}" bindchange="onStatusChange">
          <view class="picker-shell">{{statusLabels[form.statusIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">预计花费</text>
        <input class="input" value="{{form.estimatedCost}}" type="digit" placeholder="可选" bindinput="onCostInput" />
      </view>

      <view class="field">
        <text class="label">第一小步</text>
        <input class="input" value="{{form.firstStep}}" maxlength="32" placeholder="例如：先查路线和预算" bindinput="onStepInput" />
      </view>

      <button class="primary-button editor-save" bindtap="saveWish">保存愿望</button>
    </view>
  </view>

  <view class="editor-mask" wx:if="{{showGenerator}}" bindtap="closeGenerator">
    <view class="editor-panel" catchtap="noop">
      <view class="editor-head">
        <view>
          <text class="editor-title">生成准备清单</text>
          <text class="editor-copy">基于你的愿望，我们建议先做这几件事。你可以点击修改，留空则不添加。</text>
        </view>
        <text class="close-text" bindtap="closeGenerator">取消</text>
      </view>

      <view class="generator-list">
        <view class="field" wx:for="{{generatedItems}}" wx:key="index">
          <input class="input" value="{{item.title}}" maxlength="32" placeholder="输入准备项" data-index="{{index}}" bindinput="onGeneratedItemInput" />
        </view>
      </view>

      <button class="primary-button editor-save" bindtap="saveGeneratedItems">加入清单</button>
    </view>
  </view>
</view>
