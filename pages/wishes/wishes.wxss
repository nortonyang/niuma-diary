.wishes-page {
  padding-top: 34rpx;
  padding-bottom: 72rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-label,
.header-copy,
.hero-title,
.hero-copy,
.wish-title,
.wish-meta,
.wish-step,
.editor-title,
.editor-copy,
.empty-title,
.empty-copy {
  display: block;
}

.brand-label {
  color: #261f19;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.count-badge {
  min-width: 92rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #253b36;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.header-copy {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.5;
}

.cloud-status {
  display: block;
  margin-top: 8rpx;
  color: #7f7467;
  font-size: 22rpx;
  line-height: 1.4;
}

.hero-card {
  padding: 30rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #fffdf8 0%, #fff0d8 52%, #eaf5ef 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.hero-title {
  color: #253b36;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-copy {
  margin-top: 12rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.55;
}

.wish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wish-card {
  min-width: 0;
  padding: 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(81, 58, 31, 0.05);
}

.wish-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.wish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wish-tag {
  min-width: 84rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef7f1;
  color: #2f6650;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.status-tag {
  background: #fdf5e8;
  color: #a06e2e;
}

.wish-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 24rpx;
  color: #7f7467;
  font-size: 24rpx;
  font-weight: 800;
}

.action-item {
  padding: 10rpx 0;
}

.pin-item.active {
  color: #de5a32;
}

.wish-title {
  margin-top: 24rpx;
  color: #261f19;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.wish-meta,
.wish-step {
  margin-top: 12rpx;
  color: #6f6254;
  font-size: 25rpx;
  line-height: 1.6;
}

.empty-card {
  padding: 30rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.empty-title {
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 10rpx;
  color: #7f7467;
  font-size: 25rpx;
  line-height: 1.55;
}

.add-button {
  margin-top: 28rpx;
}

.add-button[disabled] {
  background: #dfd4c8;
  color: #8f8172;
}

.editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(37, 59, 54, 0.38);
}

.editor-panel {
  width: 100%;
  padding: 30rpx 28rpx 44rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #fffdf8;
}

.editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-head > view {
  min-width: 0;
  flex: 1;
}

.editor-title {
  color: #261f19;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.editor-copy {
  margin-top: 10rpx;
  color: #7f7467;
  font-size: 24rpx;
  line-height: 1.5;
}

.close-text {
  color: #8f8172;
  font-size: 24rpx;
  font-weight: 800;
}

.editor-save {
  margin-top: 30rpx;
}

.generator-list {
  margin-top: 20rpx;
}

.generator-list .field {
  margin-bottom: 16rpx;
}
