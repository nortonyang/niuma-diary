.doc-page {
  padding-top: 34rpx;
  padding-bottom: 72rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.brand-label,
.header-copy,
.hero-title,
.hero-copy,
.doc-title,
.doc-text {
  display: block;
}

.brand-label {
  color: #261f19;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.header-copy {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-card {
  padding: 30rpx;
  border: 2rpx solid #b8d9c6;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #eef7f1 0%, #fffaf0 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.hero-title {
  color: #253b36;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-copy {
  margin-top: 12rpx;
  color: #5d5043;
  font-size: 26rpx;
  line-height: 1.6;
}

.doc-card {
  padding: 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.doc-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0e2cf;
}

.doc-item:first-child {
  padding-top: 0;
}

.doc-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.doc-title {
  color: #253b36;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.doc-text {
  margin-top: 10rpx;
  color: #5d5043;
  font-size: 27rpx;
  line-height: 1.65;
}
