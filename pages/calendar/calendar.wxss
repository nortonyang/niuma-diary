.calendar-page {
  padding-top: 34rpx;
  padding-bottom: 72rpx;
}

.page-header {
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.brand-label {
  display: block;
  color: #261f19;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.header-copy {
  display: block;
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.5;
}

.tab-toggle {
  display: flex;
  background: rgba(37, 59, 54, 0.05);
  padding: 6rpx;
  border-radius: 14rpx;
}

.tab-item {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #7f7467;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #ffffff;
  color: #253b36;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.month-hero {
  padding: 30rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #fffdf8 0%, #fff0d8 62%, #eaf5ef 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.month-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.month-title,
.month-subtitle,
.hero-metric-value,
.hero-metric-label,
.hero-reason-label,
.hero-reason-text,
.detail-date,
.detail-mood,
.detail-label,
.detail-text,
.detail-note {
  display: block;
}

.month-title {
  color: #253b36;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.month-subtitle {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 24rpx;
}

.month-actions {
  display: flex;
  gap: 12rpx;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 2rpx solid #ead7bd;
  border-radius: 14rpx;
  background: rgba(255, 253, 248, 0.88);
  color: #253b36;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-metric {
  flex: 1;
  min-width: 0;
  min-height: 120rpx;
  padding: 20rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 248, 0.88);
  text-align: center;
}

.hero-metric-value {
  color: #de5a32;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-metric-label {
  margin-top: 8rpx;
  color: #7f7467;
  font-size: 20rpx;
}

.hero-reason {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: rgba(37, 59, 54, 0.08);
}

.reason-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.reason-row + .reason-row {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.hero-reason-label {
  flex-shrink: 0;
  color: #5f4830;
  font-size: 23rpx;
  font-weight: 800;
}

.hero-reason-text {
  flex: 1;
  text-align: right;
  color: #253b36;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-word;
}

.monthly-income {
  margin-top: 24rpx;
}

.monthly-footer {
  margin-top: 28rpx;
}

.empty-month-placeholder {
  margin-top: 28rpx;
  padding: 40rpx 0;
  text-align: center;
}

.calendar-board {
  padding: 24rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.week-row {
  display: flex;
  margin-bottom: 10rpx;
  color: #8f8172;
  font-size: 22rpx;
  font-weight: 800;
}

.week-row text {
  width: 14.285%;
  text-align: center;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.285%;
  padding: 8rpx 6rpx;
}

.day-card {
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

.day-cell.has-record .day-card {
  background: #fffaf0;
}

.day-cell.is-today .day-card {
  box-shadow: inset 0 0 0 2rpx #d5e9dc;
}

.day-cell.selected .day-card {
  background: #fff0d8;
  box-shadow: inset 0 0 0 2rpx #de5a32;
}

.day-number,
.day-index {
  display: block;
  text-align: center;
}

.day-number {
  min-height: 28rpx;
  color: #5d5043;
  font-size: 22rpx;
  line-height: 28rpx;
}

.day-index {
  min-width: 46rpx;
  height: 34rpx;
  margin-top: 6rpx;
  padding: 0 8rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.day-index.level-1 {
  background: #82b98f;
}

.day-index.level-2 {
  background: #e5ad47;
}

.day-index.level-3 {
  background: #de7c32;
}

.day-index.level-4 {
  background: #c84524;
}

.detail-card {
  padding: 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.detail-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-date {
  color: #261f19;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-word;
}

.detail-mood {
  margin-top: 10rpx;
  color: #2f6650;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-score {
  color: #de5a32;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.detail-block {
  margin-top: 22rpx;
}

.detail-label {
  color: #7f7467;
  font-size: 23rpx;
  font-weight: 800;
}

.detail-text {
  margin-top: 10rpx;
  color: #253b36;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
  word-break: break-word;
}

.detail-note {
  margin-top: 10rpx;
  color: #5d5043;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-title,
.empty-copy {
  display: block;
}

.empty-title {
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 10rpx;
  color: #7f7467;
  font-size: 25rpx;
  line-height: 1.55;
}

/* Weekly Report Styles */
.week-report {
  padding: 40rpx 32rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
  background: linear-gradient(165deg, #fffdf8 0%, #fcf7ef 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.report-header {
  margin-bottom: 40rpx;
}

.report-title {
  display: block;
  color: #261f19;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.report-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #7f7467;
  font-size: 26rpx;
}

.income-card {
  margin-top: 32rpx;
  padding: 30rpx;
  background: #fdf2e9;
  border-radius: 16rpx;
  border-left: 8rpx solid #de5a32;
}

.income-card.muted-card {
  background: rgba(37, 59, 54, 0.05);
  border-left-color: #ead7bd;
}

.income-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.income-label {
  color: #5f4830;
  font-size: 26rpx;
  font-weight: 800;
}

.income-value {
  color: #de5a32;
  font-size: 44rpx;
  font-weight: 900;
}

.income-copy {
  display: block;
  margin-top: 16rpx;
  color: #6f6254;
  font-size: 24rpx;
  line-height: 1.6;
}

.report-footer {
  margin-top: 60rpx;
  padding-top: 32rpx;
  border-top: 2rpx dashed #ead7bd;
  text-align: center;
}

.footer-copy {
  display: block;
  margin-top: 24rpx;
  color: #8f8172;
  font-size: 24rpx;
  font-style: italic;
}

.share-report {
  margin-bottom: 24rpx;
}

.empty-report {
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-report .empty-title {
  display: block;
  font-size: 34rpx;
  color: #261f19;
  font-weight: 900;
}

.empty-report .empty-copy {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #7f7467;
  line-height: 1.6;
}

.empty-report .primary-button {
  margin-top: 60rpx;
  width: 240rpx;
  margin-left: auto;
  margin-right: auto;
}

.empty-canvas {
  width: 320rpx;
  height: 180rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.empty-month-placeholder {
  padding: 80rpx 40rpx;
  text-align: center;
}
