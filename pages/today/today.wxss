.today-page {
  padding-top: 34rpx;
  padding-bottom: 72rpx;
}

.today-header {
  margin-bottom: 30rpx;
}

.brand-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-name {
  color: #261f19;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.streak-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #fdf2e9;
  color: #de5a32;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.header-date {
  color: #8f8172;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: right;
  white-space: pre-line;
}

.header-subtitle {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.5;
}

.draft-status {
  margin-top: 10rpx;
  color: #2f6650;
  font-size: 22rpx;
  font-weight: 700;
}

.cloud-status {
  margin-top: 8rpx;
  color: #7f7467;
  font-size: 22rpx;
  line-height: 1.4;
}

.hero-card {
  padding: 30rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #fffdf8 0%, #fff0d8 62%, #eaf5ef 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-eyebrow,
.hero-caption,
.hero-copy,
.income-label,
.income-copy {
  display: block;
}

.hero-eyebrow {
  color: #5f4830;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-caption {
  margin-top: 10rpx;
  color: #253b36;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hero-badge {
  min-width: 106rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #253b36;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.character-container {
  width: 100%;
  height: 240rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.character-image {
  width: 520rpx;
  height: 240rpx;
  display: block;
  transition: opacity 0.16s ease-out;
}

.hero-score-row {
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  margin-top: 26rpx;
}

.hero-score {
  color: #de5a32;
  font-size: 110rpx;
  font-weight: 900;
  line-height: 0.92;
}

.hero-copy-wrap {
  flex: 1;
  padding-bottom: 14rpx;
}

.hero-copy {
  color: #6f6254;
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-slider {
  margin: 26rpx 0 10rpx;
}

.scale-row {
  display: flex;
  justify-content: space-between;
  color: #8f8172;
  font-size: 22rpx;
}

.info-section {
  margin-bottom: 26rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-title {
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.section-meta {
  color: #8f8172;
  font-size: 23rpx;
}

.mood-grid {
  display: flex;
  gap: 14rpx;
}

.mood-chip {
  min-height: 92rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 14rpx;
  background: #fffdf8;
  color: #5d5043;
  box-shadow: 0 8rpx 20rpx rgba(81, 58, 31, 0.04);
}

.mood-chip.active {
  border-color: #de5a32;
  background: #fff0d8;
  color: #b83f20;
}

.mood-label {
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.extra-reasons {
  margin-top: 14rpx;
}

.reason-chip {
  min-height: 66rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 999rpx;
  background: #fffaf0;
  color: #4f4235;
  font-size: 25rpx;
  line-height: 1.25;
}

.reason-chip.active {
  border-color: #de5a32;
  background: #fff0d8;
  color: #b83f20;
  font-weight: 700;
}

.more-chip {
  background: #eef7f1;
  border-color: #cfe5d7;
  color: #2f6650;
}

.note-entry {
  margin: 6rpx 0 22rpx;
}

.note-toggle {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 6rpx;
}

.note-toggle-title {
  color: #2d2822;
  font-size: 28rpx;
  font-weight: 800;
}

.note-toggle-meta {
  color: #8f8172;
  font-size: 23rpx;
}

.note-editor {
  margin-top: 10rpx;
  padding: 22rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.note-input {
  min-height: 132rpx;
  padding: 0;
  border: 0;
  background: transparent;
}

.textarea-count {
  margin-top: 8rpx;
  color: #9a8c7d;
  font-size: 22rpx;
  text-align: right;
}

.save-button {
  margin-bottom: 24rpx;
}

.income-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid #d8e8dd;
  border-radius: 16rpx;
  background: #f3faf6;
}

.holiday-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #fffdf8 0%, #fff0d8 70%, #eaf5ef 100%);
  box-shadow: 0 12rpx 28rpx rgba(81, 58, 31, 0.06);
}

.holiday-main {
  flex: 1;
  min-width: 0;
}

.holiday-label,
.holiday-value,
.holiday-hint {
  display: block;
}

.holiday-label {
  color: #5f4830;
  font-size: 24rpx;
  font-weight: 800;
}

.holiday-value {
  margin-top: 10rpx;
  color: #de5a32;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.holiday-hint {
  margin-top: 8rpx;
  color: #7f7467;
  font-size: 22rpx;
  line-height: 1.45;
}

.holiday-badge {
  min-width: 98rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #253b36;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
}

.income-label {
  color: #2f6650;
  font-size: 24rpx;
  font-weight: 800;
}

.income-copy {
  margin-top: 8rpx;
  color: #253b36;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.income-arrow {
  color: #7a8f84;
  font-size: 42rpx;
  line-height: 1;
}

.wish-card-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
  margin-top: 24rpx;
}

.wish-mini-content {
  flex: 1;
  min-width: 0;
}

.wish-mini-label {
  display: block;
  color: #5f4830;
  font-size: 24rpx;
  font-weight: 800;
}

.wish-mini-title {
  display: block;
  margin-top: 8rpx;
  color: #261f19;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-mini-arrow {
  color: #8f8172;
  font-size: 42rpx;
  line-height: 1;
}

.quiet-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 0 6rpx;
}

.quiet-link {
  color: #7f7467;
  font-size: 24rpx;
  line-height: 1.4;
}

.countdown-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(37, 59, 54, 0.38);
}

.countdown-panel {
  width: 100%;
  padding: 30rpx 28rpx 44rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #fffdf8;
}

.countdown-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.countdown-title,
.countdown-copy,
.countdown-item-title,
.countdown-item-value,
.countdown-item-hint {
  display: block;
}

.countdown-title {
  color: #261f19;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.countdown-copy {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 24rpx;
  line-height: 1.5;
}

.countdown-close {
  color: #8f8172;
  font-size: 24rpx;
  font-weight: 800;
}

.countdown-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.countdown-item {
  padding: 22rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffaf0;
}

.countdown-item-title {
  color: #5f4830;
  font-size: 24rpx;
  font-weight: 800;
}

.countdown-item-value {
  margin-top: 10rpx;
  color: #de5a32;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.countdown-item-hint {
  margin-top: 10rpx;
  color: #7f7467;
  font-size: 22rpx;
  line-height: 1.45;
}

.success-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(37, 59, 54, 0.45);
  padding: 40rpx;
}

.success-panel {
  width: 100%;
  max-width: 600rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  overflow: hidden;
  box-shadow: 0 32rpx 72rpx rgba(37, 59, 54, 0.25);
  animation: modal-pop 0.3s ease-out;
}

@keyframes modal-pop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.success-image {
  width: 100%;
  display: block;
}

.success-content {
  padding: 34rpx 40rpx 44rpx;
  text-align: center;
}

.success-title {
  display: block;
  color: #261f19;
  font-size: 38rpx;
  font-weight: 900;
}

.success-copy {
  display: block;
  margin-top: 16rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.6;
}

.success-actions {
  margin-top: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.share-btn {
  width: 420rpx !important;
  max-width: 100%;
  margin: 0 !important;
  align-self: center;
}

.close-link {
  color: #8f8172;
  font-size: 25rpx;
  font-weight: 700;
  text-decoration: underline;
}
