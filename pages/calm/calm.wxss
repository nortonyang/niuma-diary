.calm-page {
  padding-top: 34rpx;
  padding-bottom: 72rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.brand-label,
.header-copy,
.hero-title,
.hero-copy,
.pressure-note,
.result-label,
.result-title,
.result-copy {
  display: block;
}

.brand-label {
  color: #261f19;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.header-copy {
  margin-top: 10rpx;
  color: #6f6254;
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-card {
  padding: 30rpx;
  border: 2rpx solid #b8d9c6;
  border-radius: 16rpx;
  background: linear-gradient(140deg, #eef7f1 0%, #fffaf0 100%);
  box-shadow: 0 16rpx 38rpx rgba(81, 58, 31, 0.08);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-top > view {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #253b36;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-copy {
  margin-top: 10rpx;
  color: #5d5043;
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-badge {
  min-width: 112rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #253b36;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.pressure-row {
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  margin-top: 24rpx;
}

.pressure-value {
  color: #de5a32;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 0.94;
}

.pressure-copy-wrap {
  flex: 1;
  padding-bottom: 12rpx;
}

.pressure-note {
  color: #6f6254;
  font-size: 24rpx;
  line-height: 1.5;
}

.pressure-bar {
  height: 22rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ead7bd;
}

.pressure-fill {
  height: 22rpx;
  border-radius: 999rpx;
  background: #de5a32;
}

.question-card {
  padding: 28rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 16rpx;
  background: #fffdf8;
}

.section-title {
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.switch-list {
  margin-top: 24rpx;
  border-top: 2rpx solid #f0e2cf;
}

.switch-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 2rpx solid #f0e2cf;
}

.switch-label {
  flex: 1;
  min-width: 0;
  color: #2d2822;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.switch-dot {
  min-width: 72rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #efe4d6;
  color: #7f7467;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.switch-dot.active {
  background: #253b36;
  color: #ffffff;
}

.switch-dot.warn {
  background: #de5a32;
}

.result-card {
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background: #253b36;
  box-shadow: 0 16rpx 38rpx rgba(37, 59, 54, 0.18);
}

.result-label {
  color: #cfe8d8;
  font-size: 24rpx;
  font-weight: 800;
}

.result-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.result-copy {
  margin: 18rpx 0 32rpx;
  color: #e9f4ec;
  font-size: 27rpx;
  line-height: 1.6;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.result-actions .secondary-button,
.result-actions .primary-button {
  flex: 1;
  margin: 0;
}

.result-actions .secondary-button {
  background: #3a4b41;
  color: #ffffff;
  border: 0;
}

.share-result-btn {
  background: #ffffff !important;
  color: #253b36 !important;
}

.result-button {
  background: #fffdf8;
  color: #253b36;
}

.result-secondary-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.text-button {
  background: transparent !important;
  color: #cfe8d8 !important;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
  line-height: 1.5;
  border-bottom: 2rpx solid #3a4b41;
  border-radius: 0;
}

.history-section {
  margin-top: 48rpx;
  padding: 0 10rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-subtitle {
  color: #998e82;
  font-size: 22rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 24rpx;
  border: 2rpx solid #ead7bd;
  border-radius: 12rpx;
  background: #fffdf8;
}

.history-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-date {
  color: #998e82;
  font-size: 22rpx;
  font-weight: 700;
}

.history-delete {
  color: #de5a32;
  font-size: 22rpx;
  font-weight: 700;
}

.history-item-body {
  display: flex;
  gap: 20rpx;
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-result-title {
  display: block;
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
}

.history-result-copy {
  display: block;
  margin-top: 6rpx;
  color: #6f6254;
  font-size: 24rpx;
  line-height: 1.5;
}

.history-stat-badge {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #de5a32;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.history-item-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #f0e2cf;
}

.history-detail {
  display: block;
  color: #998e82;
  font-size: 22rpx;
}

.history-choice {
  margin-top: 8rpx;
  line-height: 1.45;
}
